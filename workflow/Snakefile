rule ciftify_recon_all:
    input:
        os.path.join(outdir, "fmriprep", "sourcedata", "freesurfer", "sub-{subid}", "surf", "rh.thickness")
    params:
        bids_dir=rawdir,
        out_dir=outdir,
        fs_license_dir=resourcedir
    threads: 8
    resources:
        mem='16G',
        time='12:00:00'
    output:
        os.path.join(
            outdir,
            "ciftify",
            "sub-{subid}",
            "MNINonLinear",
            "fsaverage_LR32k",
            "sub-{subid}.aparc.32k_fs_LR.dlabel.nii"
        ),
        os.path.join(
            outdir,
            "ciftify",
            "sub-{subid}",
            "MNINonLinear",
            "aparc+aseg.nii.gz"
        )
    container:
        config["containers"]["ciftify"]
    shell:
        "rm -rf {params.out_dir}/ciftify/sub-{wildcards.subid} && "
        "ciftify_recon_all "
        "--ciftify-work-dir {params.out_dir}/ciftify "
        "--fs-subjects-dir {params.out_dir}/fmriprep/sourcedata/freesurfer "
        "--fs-license {params.fs_license_dir}/license.txt "
        "-vvv "
        "sub-{wildcards.subid}"

rule ciftify_subject_fmri:
    input:
        os.path.join(
            outdir,
            "ciftify",
            "sub-{subid}",
            "MNINonLinear",
            "fsaverage_LR32k",
            "sub-{subid}.aparc.32k_fs_LR.dlabel.nii"
        ),
        os.path.join(
            outdir,
            "fmriprep",
            "sub-{subid}",
            "func",
            "sub-{subid}_task-rest_space-MNI152NLin2009cAsym_res-2_desc-preproc_bold.nii.gz"
        )
    params:
        bids_dir=rawdir,
        out_dir=outdir,
        fs_license_dir=resourcedir
    output:
        os.path.join(
            outdir,
            "ciftify",
            "sub-{subid}",
            "MNINonLinear/Results/task-rest_desc-preproc/task-rest_desc-preproc_Atlas_s0.dtseries.nii"
        )
    container:
        config["containers"]["ciftify"]
    shell:
        "ciftify_subject_fmri "
        "--ciftify-work-dir {params.out_dir}/ciftify "
        "{params.out_dir}/fmriprep/sub-{wildcards.subid}/func/sub-{wildcards.subid}_task-rest_space-MNI152NLin2009cAsym_desc-preproc_bold.nii.gz "
        "sub-{wildcards.subid} "
        "task-rest_desc-preproc"


rule ciftify_atlas:
    input:
        atlas=os.path.join(
            outdir,
            "ciftify",
            "sub-{subid}",
            "MNINonLinear",
            "aparc+aseg.nii.gz"
        ),
        bold=os.path.join(
            outdir,
            "ciftify",
            "sub-{subid}",
            "MNINonLinear/Results/task-rest_desc-preproc/task-rest_desc-preproc_Atlas_s0.dtseries.nii"
        )
    params:
        cifti_dir=os.path.join(outdir, "ciftify"),
        workflow_dir=workflowdir
    output:
        os.path.join(
            outdir,
            "atlases",
            "sub-{subid}",
            "atlas-aparc+aseg",
            "atlas-aparc+aseg_space-fsLR_den-32k_dseg.dlabel.nii"
        )
    container:
        config["containers"]["ciftify"]
    shell:
        "ciftify_vol_result "
        "sub-{wildcards.subid} "
        "{input.atlas} "
        "{output} "
        "--ciftify-work-dir {params.cifti_dir} "
        "--integer-labels --resample-nifti && "
        "wb_command -cifti-label-import "
        "{params.cifti_dir}/sub-{wildcards.subid}/sub-{wildcards.subid}.aparcaseg.dscalar.nii '' "
        "{params.cifti_dir}/sub-{wildcards.subid}/sub-{wildcards.subid}.aparcaseg.dlabel.nii && "
        "mkdir -p {params.outdir}/atlases/sub-{wildcards.subid}/atlas-aparc+aseg && "
        "cp {params.cifti_dir}/sub-{wildcards.subid}/sub-{wildcards.subid}.aparcaseg.dlabel.nii "
        "{params.outdir}/atlases/sub-{wildcards.subid}/atlas-aparc+aseg/atlas-aparc+aseg_space-fsLR_den-32k_dseg.dlabel.nii"

rule xcp_d:
    input:
        os.path.join(
            outdir,
            "fmriprep",
            "sub-{subid}",
            "func",
            "sub-{subid}_task-rest_space-fsLR_den-91k_bold.dtseries.nii"
        ),
        os.path.join(
            outdir,
            "atlases",
            "sub-{subid}",
            "atlas-aparc+aseg",
            "atlas-aparc+aseg_space-fsLR_den-32k_dseg.dlabel.nii"
        )
    params:
        out_dir=outdir,
        fs_license_dir=resourcedir,
        workflow_dir=workflowdir,
        atlas_dir=os.path.join(
            outdir,
            "atlases",
            "sub-{subid}",
            "atlas-aparc+aseg"
        )
    threads: 8
    resources:
        mem='16G',
        time='06:00:00'
    output:
        os.path.join(
            outdir,
            "xcp_d",
            "sub-{subid}",
            "func",
            "sub-{subid}_task-rest_space-fsLR_seg-aparc+aseg_den-91k_stat-mean_timeseries.ptseries.nii"
        ),
        os.path.join(
            outdir,
            "xcp_d",
            "sub-{subid}",
            "func",
            "sub-{subid}_task-rest_space-fsLR_seg-aparc+aseg_den-91k_stat-pearsoncorrelation_boldmap.pconn.nii"
        )
    container:
        config["containers"]["xcp_d"]
    shell:
        "rm -rf {params.workflow_dir}/working_dir && "
        "xcp_d "
        "{params.out_dir}/fmriprep "
        "{params.out_dir}/xcp_d "
        "participant "
        "--participant-label {wildcards.subid} "
        "--mode linc "
        "--despike "
        "--nuisance-regressors acompcor "
        "--datasets aparc+aseg={params.atlas_dir} "
        "--atlases aparc+aseg "
        "--head_radius 40 "
        "--fs-license-file {params.fs_license_dir}/license.txt "
        "--smoothing 6 "
        "--n_cpus 16"

